# market-data-mcp — copy to .env and fill in as needed.
# Every value below is a documented default; the two credential references are
# required for the CoinMarketCap and FRED/ALFRED tools respectively.
# fomc_calendar_list needs neither a credential nor network access.

# Transport / MCP server (see agent_connector_sdk.mcp.parser for the full flag set)
TRANSPORT=stdio
MCP_TOOL_MODE=condensed

# Contact identity advertised in the User-Agent header
MARKET_DATA_CONTACT_EMAIL=connectors@knuckles.team

# Credentials — env:// (default) or openbao://apps/market-data-mcp#<FIELD>
MARKET_DATA_CMC_API_KEY=env://MARKET_DATA_CMC_API_KEY
MARKET_DATA_FRED_API_KEY=env://MARKET_DATA_FRED_API_KEY

# Per-source overrides (base URLs, request pacing, page sizes) — see config.py;
# uncomment only to point at a mirror or tune throughput.
# MARKET_DATA_CMC_BASE_URL=https://pro-api.coinmarketcap.com
# MARKET_DATA_CMC_MIN_INTERVAL=2.0
# MARKET_DATA_CMC_PAGE_SIZE=100
# MARKET_DATA_FRED_BASE_URL=https://api.stlouisfed.org/fred
# MARKET_DATA_FRED_MIN_INTERVAL=0.5
# MARKET_DATA_FRED_PAGE_SIZE=1000
# MARKET_DATA_FOMC_SOURCE_URL=https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm
